# Database
PG_USER=fasikul
PG_PASSWORD=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# MinIO
MINIO_USER=fasikul
MINIO_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=fasikul

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=source_chunks

# Domain (for Caddy TLS)
DOMAIN=fasikul.example.com

# Tailscale IP (bind Redis/MinIO for PC worker access)
# TAILSCALE_IP=100.x.x.x

# --- LLM Providers ---
# Primary: DeepSeek (structured tasks + main generation)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Fast/cheap: Groq (QA pass, checklist eval)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Anthropic (premium fallback, can leave empty)
ANTHROPIC_API_KEY=

# --- LLM Routing config (which pass uses which provider) ---
# Options: deepseek | groq | anthropic
LLM_TOPIC_EXTRACTION=deepseek
LLM_PASS1_OUTLINE=deepseek
LLM_PASS2_EXPAND=deepseek
LLM_PASS3_ENRICH=deepseek
LLM_PASS4_QUESTIONS=deepseek
LLM_PASS5_QA=groq

# Database URL (constructed)
DATABASE_URL=postgresql+asyncpg://fasikul:change_me_strong_password@postgres:5432/fasikul

# App
DEFAULT_LANGUAGE=tr
DEFAULT_DEPTH=comprehensive
SECRET_KEY=change_me_secret_key_for_sessions
